  <h2>7. Descuentos</h2>
  <table>
    <tr><th>Descuento</th><th>Estado</th><th>Tipo</th><th>Alcance</th><th>Valor</th><th>Implicancia</th></tr>
    <tr><td>pago en efectivo</td><td>Habilitado</td><td>General</td><td>Total</td><td>10%</td><td>Aplica como descuento general habilitado.</td></tr>
    <tr><td>pago con tarjeta</td><td>Deshabilitado</td><td>General</td><td>Ambos</td><td>1%</td><td>Esta configurado pero no aplica mientras siga deshabilitado.</td></tr>
